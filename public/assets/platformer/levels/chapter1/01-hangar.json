  "story": {
    "beats": [
      {
        "id": "wake",
        "trigger": {
          "type": "start"
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Piezod, soy LUMA. Estás en una estación espacial. La tripulación ha desaparecido.",
            "duration": 2.5
          }
        ]
      },
      {
        "id": "tutorial-move",
        "trigger": {
          "type": "zone",
          "col": 10,
          "row": 14,
          "width": 4,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Flechas o A/D para moverte. Mantén ESPACIO para saltar más alto.",
            "touchText": "Usa las flechas de la pantalla. Mantén el botón de salto para llegar más alto.",
            "duration": 2
          }
        ]
      },
      {
        "id": "tutorial-crates",
        "trigger": {
          "type": "zone",
          "col": 20,
          "row": 14,
          "width": 3,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Cápsulas vacías. La evacuación quedó a medias... Busca una salida entre los contenedores.",
            "duration": 2
          }
        ]
      },
      {
        "id": "hangar-enter",
        "trigger": {
          "type": "zone",
          "col": 25,
          "row": 14,
          "width": 3,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Explorador delante. El ojo rojo avisa de su embestida. Esquiva, dispara o salta sobre él.",
            "duration": 2
          }
        ]
      },
      {
        "id": "signs-of-fight",
        "trigger": {
          "type": "zone",
          "col": 45,
          "row": 14,
          "width": 3,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Los invasores alteraron la seguridad. Esos drones ya no reconocen a la tripulación.",
            "duration": 2.5
          }
        ]
      },
      {
        "id": "cargo",
        "trigger": {
          "type": "zone",
          "col": 123,
          "row": 14,
          "width": 4,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Carga abandonada. Las plataformas aún funcionan. Espera una base firme antes de atacar.",
            "duration": 2
          }
        ]
      },
      {
        "id": "security",
        "trigger": {
          "type": "zone",
          "col": 196,
          "row": 12,
          "width": 3,
          "height": 9
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Seguridad activa. Espera el aviso de los láseres; el centinela queda expuesto tras disparar.",
            "duration": 2.5
          }
        ]
      },
      {
        "id": "switch-found",
        "trigger": {
          "type": "zone",
          "col": 228,
          "row": 14,
          "width": 4,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "El interruptor elevado abre ambas puertas. Puedes dejar atrás al centinela."
          }
        ]
      },
      {
        "id": "containers",
        "trigger": {
          "type": "zone",
          "col": 264,
          "row": 14,
          "width": 3,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Marcas de plasma en los contenedores. Úsalos como cobertura entre disparos.",
            "duration": 2
          }
        ]
      },
      {
        "id": "human-fragment",
        "trigger": {
          "type": "zone",
          "col": 321,
          "row": 12,
          "width": 4,
          "height": 9
        },
        "lines": [
          {
            "speaker": "transmision",
            "text": "...aquí... supervivientes... nos llevan... (señal perdida)",
            "duration": 2
          }
        ]
      },
      {
        "id": "terminal",
        "blocking": true,
        "trigger": {
          "type": "zone",
          "col": 366,
          "row": 14,
          "width": 7,
          "height": 7
        },
        "lines": [
          {
            "speaker": "luma",
            "text": "Terminal recuperada. Es una llamada humana de auxilio. Escucha."
          },
          {
            "speaker": "transmision",
            "text": "Si alguien puede oírme... nos están llevando... no dejéis que lleguen al Núcleo..."
          },
          {
            "speaker": "luma",
            "text": "Los NÉXAR se llevaron a la tripulación hacia el Núcleo. Piezod, aún podemos encontrarlos."
          }
        ]
      }
    ]
  }
}
