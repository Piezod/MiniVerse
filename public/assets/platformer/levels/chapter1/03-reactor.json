  "story": {
    "beats": [
      { "id": "reactor-arrival", "trigger": { "type": "start" }, "lines": [{ "speaker": "luma", "text": "Los registros de Pasillos apuntan aquí. El reactor alimenta algo ajeno a esta estación.", "duration": 3 }] },
      { "id": "alien-extraction", "trigger": { "type": "zone", "col": 20, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Tecnología NÉXAR: usa nuestra energía para transportar prisioneros. Debemos cortar la extracción.", "duration": 3 }] },
      { "id": "electric-training", "trigger": { "type": "zone", "col": 210, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Dron eléctrico delante: vigila su aviso y ataca al enfriarse. Su casco resiste energía, no es inmune.", "duration": 3 }] },
      { "id": "technician-intro", "trigger": { "type": "zone", "col": 262, "row": 19, "width": 4, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Un técnico NÉXAR prepara un disparo. Tiene que detenerse: esquiva y aprovecha su recuperación.", "duration": 3 }] },
      { "id": "transport-route", "trigger": { "type": "zone", "col": 410, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Las plataformas salvan los conductores. Espera sobre apoyo firme; abajo las descargas siguen por ciclos.", "duration": 3 }] },
      { "id": "drone-defense", "trigger": { "type": "zone", "col": 608, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Drones protegen los reguladores. Busca cobertura y cambia de altura entre sus avisos.", "duration": 3 }] },
      { "id": "regulation-plan", "trigger": { "type": "zone", "col": 808, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Activa los tres reguladores, de izquierda a derecha. Cada circuito abre su puerta y anula una descarga.", "duration": 3 }] },
      { "id": "reactor-defenders", "trigger": { "type": "zone", "col": 1008, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Defensas del núcleo. Los reguladores han anulado sus peligros; aprovecha las pausas de los guardianes.", "duration": 3 }] },
      { "id": "overload-checkpoint", "trigger": { "type": "zone", "col": 1185, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Punto de control. Sigue una sobrecarga: los circuitos ya activados se conservan si tu armadura cae.", "duration": 3 }] },
      { "id": "escape-checkpoint", "trigger": { "type": "zone", "col": 1385, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Último punto de control. Las defensas del escape usan reserva: combina plataformas, cobertura y pausas.", "duration": 3 }] },
      { "id": "escape-platforms", "trigger": { "type": "zone", "col": 1408, "row": 19, "width": 4, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Cruza en la plataforma. Después usa el ascensor para superar la compuerta dañada y flanquear la defensa.", "duration": 3 }] },
      { "id": "overload-route", "trigger": { "type": "zone", "col": 1208, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "La energía busca una salida. Cruza por ciclos y alcanza el control elevado para aislar la extracción.", "duration": 3 }] },
      { "id": "extraction-stopped", "trigger": { "type": "zone", "col": 1372, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Extracción detenida. El reactor está estable, pero las defensas del escape aún tienen energía de reserva.", "duration": 3 }] },
      { "id": "omega-protocol", "blocking": true, "trigger": { "type": "zone", "col": 1555, "row": 19, "width": 9, "height": 6 }, "lines": [
        { "speaker": "luma", "text": "Protocolo OMEGA activado. Unidad de defensa OMEGA-7 en funcionamiento" },
        { "speaker": "piezod", "text": "Ya no pueden usar este reactor para transportar prisioneros. Vamos a por su unidad de defensa." }
      ] }
    ]
  }
}