  "story": {
    "beats": [
      { "id": "corridors-arrival", "trigger": { "type": "start" }, "lines": [{ "speaker": "luma", "text": "La señal humana sigue por estos pasillos. La seguridad ya no responde a mis órdenes.", "duration": 2.5 }] },
      { "id": "security-log-one", "trigger": { "type": "zone", "col": 18, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "transmision", "text": "REGISTRO 01: alarma de intrusión. Personal reunido por la fuerza. Orden de evacuación anulada.", "duration": 3 }] },
      { "id": "reprogrammed-defense", "trigger": { "type": "zone", "col": 172, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Los NÉXAR reprogramaron las defensas. La torreta fija avisa en rojo: salta o busca cobertura.", "duration": 3 }] },
      { "id": "two-circuits", "trigger": { "type": "zone", "col": 329, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Guardián delante. Su escudo bloquea el frente: salta la embestida y ataca por detrás al recuperarse.", "duration": 3 }] },
      { "id": "armored-defense", "trigger": { "type": "zone", "col": 490, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Torreta y explorador. Cambia de altura para esquivar sus ataques y aprovecha la recarga.", "duration": 3 }] },
      { "id": "security-log-two", "trigger": { "type": "zone", "col": 618, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "transmision", "text": "REGISTRO 02: civiles detenidos. Destino: plataforma de transporte exterior. No fue una evacuación.", "duration": 3 }] },
      { "id": "maintenance-route", "trigger": { "type": "zone", "col": 647, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Activa el acceso. Los ascensores de mantenimiento llevan al paso superior; abajo hay un muro cerrado.", "duration": 3 }] },
      { "id": "combined-security", "trigger": { "type": "zone", "col": 806, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Los interruptores abren puertas y anulan sus láseres. Actívalos antes de avanzar al siguiente sector.", "duration": 3 }] },
      { "id": "archive-rest", "trigger": { "type": "zone", "col": 976, "row": 19, "width": 5, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Último puesto defensivo. La torreta apunta a la derecha; cruza por arriba y flanquea al guardián.", "duration": 2.5 }] },
      { "id": "transport-record", "blocking": true, "trigger": { "type": "zone", "col": 1081, "row": 19, "width": 8, "height": 6 }, "lines": [
        { "speaker": "transmision", "text": "REGISTRO 03: prisioneros humanos transferidos a una nave NÉXAR. Transporte fuera de la estación confirmado." },
        { "speaker": "luma", "text": "La tripulación fue capturada, no evacuada. Los registros de destino están en el reactor." },
        { "speaker": "piezod", "text": "Entonces seguiremos su rastro. Guarda el manifiesto, LUMA." }
      ] }
    ]
  }
}