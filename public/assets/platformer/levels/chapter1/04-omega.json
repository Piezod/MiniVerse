  },
  "story": {
    "beats": [
      { "id": "core-arrival", "trigger": { "type": "start" }, "lines": [{ "speaker": "luma", "text": "El reactor ya no alimenta el transporte. Solo queda el núcleo de seguridad: OMEGA-7 protege sus registros.", "duration": 3 }] },
      { "id": "outer-defense", "trigger": { "type": "zone", "col": 168, "row": 19, "width": 4, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Última línea defensiva. Aprovecha los avisos y reserva energía para la unidad del núcleo.", "duration": 3 }] },
      { "id": "access-controls", "trigger": { "type": "zone", "col": 326, "row": 19, "width": 4, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Dos controles abren el acceso. El primero está elevado; el segundo anula el láser del pasillo.", "duration": 3 }] },
      { "id": "boss-checkpoint", "trigger": { "type": "zone", "col": 622, "row": 19, "width": 4, "height": 6 }, "lines": [{ "speaker": "luma", "text": "Punto de control. OMEGA abre el núcleo después de atacar. Salta sobre la embestida y usa las plataformas.", "duration": 3 }] },
      { "id": "omega-introduction", "trigger": { "type": "event" }, "blocking": true, "lines": [
        { "speaker": "omega-7", "text": "Armadura PIEZOD reconocida. Tu despertar no fue accidental. La secuencia de activación llevaba tu firma." },
        { "speaker": "piezod", "text": "Entonces sabes quién se llevó a la tripulación. Dame las coordenadas." },
        { "speaker": "luma", "text": "Su núcleo se expone tras cada patrón. Durante los cambios de fase, busca posición: las defensas se retiran." }
      ] },
      { "id": "omega-defeated", "trigger": { "type": "event" }, "blocking": true, "lines": [
        { "speaker": "luma", "text": "Unidad neutralizada. Recupero las coordenadas del planeta donde están retenidos los humanos." },
        { "speaker": "omega-7", "text": "PIEZOD... tú ya estuviste allí. Ellos te estaban esperando" },
        { "speaker": "piezod", "text": "No recuerdo ese planeta. Pero esta vez no pienso dejarlos allí." },
        { "speaker": "luma", "text": "Coordenadas guardadas. La estación fantasma queda atrás. Capítulo 2: Planeta alienígena. Próximamente." }
      ] }
    ]
  }
}